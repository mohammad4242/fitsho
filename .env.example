DATABASE_URL=postgresql+psycopg://fitsho:fitsho@localhost:5432/fitsho
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=local
COOKIE_SECURE=false
SESSION_COOKIE_NAME=fitsho_session
SESSION_TTL_SECONDS=604800
MEDIA_ROOT=var/media
MEDIA_PUBLIC_PATH=/media
MEDIA_MAX_BYTES=20971520
MEDIA_MAX_VIDEO_DURATION_SECONDS=20
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=5
# Backend only. Keep a real key in backend/.env; never expose or commit it.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=gpt-5.6-terra
OPENCODE_ZEN_TIMEOUT_SECONDS=30
# Optional backend-only proxy for Zen, for example socks5://127.0.0.1:10808
OPENCODE_ZEN_PROXY_URL=
OPENROUTER_PROXY_URL=
FOOD_PHOTO_STORAGE_ROOT=var/private/food-photos
FOOD_PHOTO_MAX_BYTES=8388608
FOOD_PHOTO_MAX_PIXELS=20000000
FOOD_PHOTO_RETENTION_DAYS=30
FOOD_PHOTO_RATE_LIMIT=10
NUTRITION_LAB_STORAGE_ROOT=var/private/nutrition-labs
NUTRITION_LAB_MAX_BYTES=12582912
NUTRITION_LAB_MAX_PIXELS=20000000
NUTRITION_LAB_RETENTION_DAYS=2555
NUTRITION_LAB_UPLOAD_RATE_LIMIT=20
NUTRITION_UPLOAD_RATE_WINDOW_SECONDS=3600
PRIVATE_FILE_ACCESS_TTL_SECONDS=300
PRIVATE_FILE_SIGNING_KEY=replace-with-at-least-32-random-characters
WORKOUT_PROMPT_VERSION=v1
WORKOUT_POLICY_VERSION=v1
WORKOUT_CATALOG_PROGRAMMING_VERSION=v1
WORKOUT_MAX_REPAIR_ATTEMPTS=1
WORKOUT_GENERATION_COOLDOWN_SECONDS=300
WORKOUT_MAX_CANDIDATES=80
WORKOUT_MAX_REQUEST_BYTES=262144
WORKOUT_WARMUP_MINUTES=5
# Fitsho keeps its own normalized price history. A public provider is optional;
# leave empty until a documented, approved source is configured.
FOOD_PRICE_UPDATE_ENABLED=true
FOOD_PRICE_UPDATE_TIMEZONE=Asia/Tehran
FOOD_PRICE_UPDATE_HOUR=12
FOOD_PRICE_UPDATE_MINUTE=0
FOOD_PRICE_PROVIDER_TIMEOUT_SECONDS=15
FOOD_PRICE_PROVIDER_RETRIES=3
FOOD_PRICE_PUBLIC_SOURCE_URL=
# Future paid provider settings. Empty values are fully supported.
FOOD_PRICE_API_KEY=
FOOD_PRICE_API_BASE_URL=
