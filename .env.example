DATABASE_URL=postgresql+psycopg://fitsho:fitsho@localhost:5432/fitsho
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=local
COOKIE_SECURE=false
SESSION_COOKIE_NAME=fitsho_session
SESSION_TTL_SECONDS=604800
MEDIA_ROOT=var/media
MEDIA_PUBLIC_PATH=/media
MEDIA_MAX_BYTES=20971520
MEDIA_MAX_VIDEO_DURATION_SECONDS=20
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=5
# Backend only. Keep a real key in backend/.env; never expose or commit it.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=gpt-5.6-terra
OPENCODE_ZEN_TIMEOUT_SECONDS=30
# Optional backend-only proxy for Zen, for example socks5://127.0.0.1:10808
OPENCODE_ZEN_PROXY_URL=
OPENROUTER_PROXY_URL=
WORKOUT_PROMPT_VERSION=v1
WORKOUT_POLICY_VERSION=v1
WORKOUT_CATALOG_PROGRAMMING_VERSION=v1
WORKOUT_MAX_REPAIR_ATTEMPTS=1
WORKOUT_GENERATION_COOLDOWN_SECONDS=300
WORKOUT_MAX_CANDIDATES=80
WORKOUT_MAX_REQUEST_BYTES=262144
WORKOUT_WARMUP_MINUTES=5
