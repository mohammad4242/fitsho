{
  "name": "@fitician/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "test": "vitest run auth/*.test.ts data/*.test.ts",
    "test:auth": "vitest run auth/*.test.ts",
    "test:foundation": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-foundation.mjs && node scripts/validate-environments.mjs && node scripts/validate-dependencies.mjs"
  },
  "dependencies": {
    "@fitician/core": "0.1.0",
    "expo": "~57.0.0",
    "expo-build-properties": "~57.0.2",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.2",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
