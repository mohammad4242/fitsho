{
  "name": "@fitician/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "test": "vitest run accountDeletion/*.test.ts api/*.test.ts auth/*.test.ts bodyAnalysis/*.test.ts coach/*.test.ts config/*.test.ts data/*.test.ts exercises/*.test.ts media/*.test.ts notifications/*.test.ts nutrition/*.test.ts onboarding/*.test.ts physician/*.test.ts platform/*.test.ts profile/*.test.ts ui/*.test.ts upload/*.test.ts video/*.test.ts workouts/*.test.ts",
    "pretest:native": "npm --prefix .. run build:core",
    "test:native": "jest --config jest.config.cjs --runInBand",
    "test:auth": "vitest run auth/*.test.ts",
    "test:foundation": "node --test scripts/*.test.mjs",
    "validate:device-matrix": "node scripts/validate-device-matrix.mjs",
    "validate:maestro": "node scripts/validate-maestro.mjs",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "validate:store-readiness": "node scripts/validate-store-readiness.mjs",
    "build:android:debug": "node scripts/release-build-plan.mjs --profile development",
    "build:android:internal": "node scripts/release-build-plan.mjs --profile preview",
    "build:android:production": "node scripts/release-build-plan.mjs --profile production",
    "export:android:source-maps": "node scripts/releaseArtifacts.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-foundation.mjs && node scripts/validate-environments.mjs && node scripts/validate-dependencies.mjs && node scripts/validate-device-matrix.mjs && node scripts/validate-maestro.mjs && node scripts/validate-release-config.mjs && node scripts/validate-store-readiness.mjs"
  },
  "dependencies": {
    "@fitician/body-vision": "file:modules/fitician-body-vision",
    "@fitician/core": "0.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.0",
    "expo-auth-session": "~57.0.11",
    "expo-background-task": "~57.0.16",
    "expo-build-properties": "~57.0.2",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.1",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "nitrogen": "0.37.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
